# Copy to .env and fill in. Never commit .env — add it to .gitignore first.

# From the Cloudflare Zero Trust dashboard when you create the tunnel.
# Treat this like a password: anyone holding it can publish to your hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# Local development database only. Not customer data.
POSTGRES_USER=hrp_dev
POSTGRES_PASSWORD=

# Which address Postgres listens on. Leave as loopback until the QSFP link
# between the two GB10s is configured — otherwise Docker cannot bind and
# nothing starts. Change it to this node's QSFP address when you set up the
# standby on node two.
QSFP_IP=127.0.0.1

# The second GB10 over the QSFP link. Used by preflight.sh to test the link.
PEER_IP=
